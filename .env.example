SECRET_KEY=django-insecure-change-me
DEBUG=on

# Security headers (set to True in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
CSRF_TRUSTED_ORIGINS=""
# Production recommendations:
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True

ALLOWED_HOSTS=*

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/acalmo
# DATABASE_URL=postgres://postgres:postgres@db:5432/acalmo

POSTGRES_DB=acalmo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

GS_BUCKET_NAME=""
GS_PROJECT_ID=""

STORAGE_DEFAULT_BACKEND=django.core.files.storage.FileSystemStorage
STORAGE_STATIC_BACKEND=django.contrib.staticfiles.storage.StaticFilesStorage

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=""
EMAIL_HOST_PASSWORD=""
EMAIL_HOST_USER=""
EMAIL_PORT=587

# reCAPTCHA Configuration
RECAPTCHA_PUBLIC_KEY=""
RECAPTCHA_PRIVATE_KEY=""
RECAPTCHA_REQUIRED_SCORE=0.50
